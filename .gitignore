# One-off scratch: benchmarked Bedrock models to pick the one wired into rag.py.
# Kept locally, not part of the deployed app.
backend/compare.py

# Build-time only: embed_chunks.py writes it, export_index.py turns it into
# backend/data/index/ (which IS tracked, and is what ships in the image).
# Regenerate with `python embed_chunks.py`.
backend/chroma_db/

# pbpstats extension: fetch_pbpstats.py's gzipped API response cache and the
# bulk CSVs it renders from it (~445 MB; pbpstats_lineups.csv alone is 302 MB,
# past GitHub's 100 MB per-file limit). Build-time inputs only — no committed
# artifact depends on them, and re-running fetch_pbpstats.py rebuilds them.
data/pbpstats_raw/
data/pbpstats_lineups.csv
data/pbpstats_players.csv

# AWS CLI scratch output
/response.json

# Root-level pipeline outputs (regenerate with rec_sys.py)
